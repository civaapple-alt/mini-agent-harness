# Copy this file to .env (or ~/.mini-agent/.env), then provide your API key.

# Primary model provider settings (DeepSeek / OpenAI Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com

# Enable/disable built-in Responses API web_search tool (default: true)
MINI_AGENT_WEB_SEARCH=true

# Copilot / auto mode maximum model steps (default: 0 = unlimited)
MINI_AGENT_MAX_STEPS=0

# Optional independent model for durable-session insight and verification.
# The mentor inherits OPENAI_API_KEY and OPENAI_BASE_URL unless overridden.
MENTOR_OPENAI_MODEL=
MENTOR_OPENAI_API_KEY=
MENTOR_OPENAI_BASE_URL=
