# Copy this file to .env (or ~/.mini-agent/.env), then provide your API key.

# Primary model provider settings (DeepSeek / OpenAI Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com

# Enable/disable built-in Responses API web_search tool (default: true)
MINI_AGENT_WEB_SEARCH=true

# Optional Goal Runtime bounds. These are long-running safety limits, not a
# user-facing step budget. Current defaults are 100 / 200 / 1800 seconds.
# MINI_AGENT_GOAL_MAX_LOOPS=100
# MINI_AGENT_GOAL_STEP_BUDGET=200
# MINI_AGENT_GOAL_TIMEOUT_SECS=1800

# Optional independent model for Goal verification. The verifier inherits the
# primary API key and base URL unless the following values are overridden.
# VERIFIER_OPENAI_MODEL=
# VERIFIER_OPENAI_API_KEY=
# VERIFIER_OPENAI_BASE_URL=

# Project/workspace bindings are normally injected by Web Studio. Set these
# only for a standalone Host/App Server process when the binding is trusted.
# MINI_AGENT_PROJECT_ID=
# MINI_AGENT_EXTRA_READ_ROOTS=
# MINI_AGENT_EXTRA_WRITE_ROOTS=
